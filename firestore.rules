rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function owns(uid) {
      return request.auth != null && request.auth.uid == uid;
    }

    function validSlotId(slotId) {
      return slotId in [
        'manual-1',
        'manual-2',
        'manual-3',
        'manual-4',
        'manual-5',
        'autosave'
      ];
    }

    match /users/{uid}/slots/{slotId} {
      allow read: if owns(uid) && validSlotId(slotId);
      allow create, update: if owns(uid)
        && validSlotId(slotId)
        && request.resource.data.keys().hasOnly([
          'key',
          'profileId',
          'slotId',
          'formatVersion',
          'savedAt',
          'progress',
          'gameState'
        ])
        && request.resource.data.key == uid + '::' + slotId
        && request.resource.data.profileId == uid
        && request.resource.data.slotId == slotId
        && request.resource.data.formatVersion == 1
        && request.resource.data.savedAt is string
        && request.resource.data.progress is map
        && request.resource.data.gameState is map
        && request.resource.data.gameState.schemaVersion == 1;
      allow delete: if false;
    }

    match /users/{uid}/profile/endings {
      allow read: if owns(uid);
      allow create, update: if owns(uid)
        && request.resource.data.keys().hasOnly([
          'profileId',
          'formatVersion',
          'endingIds',
          'updatedAt'
        ])
        && request.resource.data.profileId == uid
        && request.resource.data.formatVersion == 1
        && request.resource.data.endingIds is list
        && request.resource.data.endingIds.size() <= 100
        && request.resource.data.updatedAt is string;
      allow delete: if false;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
